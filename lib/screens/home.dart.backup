import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:firebase_auth/firebase_auth.dart';
import 'package:flutter/material.dart';
import 'package:groundwater_management/functions/rounded_button.dart';
import 'package:groundwater_management/l10n/language_picker.dart';
import 'package:groundwater_management/profile/userprofile.dart';
import 'package:groundwater_management/screens/adddatascreen.dart';
import 'package:groundwater_management/screens/comparegraphscreen.dart';
import 'package:groundwater_management/screens/graphscreen.dart';
import 'package:groundwater_management/screens/searchscreen.dart';
import 'package:groundwater_management/screens/viewaddeddatascreen.dart';
import 'package:groundwater_management/screens/welcome.dart';
import 'package:flutter_gen/gen_l10n/app_localizations.dart';
import 'viewaddeddatascreen.dart';
import 'package:groundwater_management/screens/bluetooth_control_screen.dart'; // ← ADDED THIS IMPORT
import 'package:groundwater_management/screens/prediction_screen.dart';

final FirebaseAuth _auth = FirebaseAuth.instance;
String _phone='';
final List<Map<String, dynamic>> _items1=[];
List list1=[];

class UserProfile {  // RENAMED from User to UserProfile
  String name, phone, wellid, address, city, pin, state, id;
  UserProfile({required this.name, required this.phone, required this.wellid,
    required this.address, required this.city, required this.pin, required this.state, required this.id});
}

class Home extends StatefulWidget {
  @override
  _HomeState createState() => _HomeState();
}

class _HomeState extends State<Home> {

  getUserDetail() async{
    User? user = _auth.currentUser;  // This is Firebase User
    if (user != null) {
      _phone = user.phoneNumber!.substring(3, user.phoneNumber!.length);
      getwellidList();
      _items1.clear();
      for(int u=0;u<list1.length;u++){
        if(list1[u].phone==_phone) {
          _items1.add({
            'value': list1[u].name,
            'label': 'name',});
          _items1.add({
            'value': list1[u].phone,
            'label': 'phone',});
          _items1.add({
            'value': list1[u].wellid,
            'label': 'wellid',});
          _items1.add({
            'value': list1[u].address,
            'label': 'address',});
          _items1.add({
            'value': list1[u].city,
            'label': 'city',}); 
           _items1.add({
            'value': list1[u].pin,
            'label': 'pin',});
          _items1.add({
            'value': list1[u].state,
            'label': 'state',});
          _items1.add({
            'value': list1[u].id,
            'label': 'id',});
            break;
        }
      }

      Navigator.of(context).push(MaterialPageRoute(
          builder: (context) => Profile(_items1)
      ));
    }
  }
  
  getwellidsforadding() async{
    User? user = _auth.currentUser;  // This is Firebase User
    if (user != null) {
      _phone = user.phoneNumber!.substring(3, user.phoneNumber!.length);
      getwellidList();
      _items1.clear();
      for (int i = 0; i < list1.length; i++) {
        if (list1[i].phone == _phone) {
          var s = list1[i].wellid.split(',');
          for (int j = 0; j < s.length; j++) {
            var temp=s[j].indexOf(' ');
            if(temp!=-1){
              s[j]=s[j].trim();
            }
            _items1.add({
              'value': s[j],
              'label': s[j],
            });
          }
        }
      }
      _items1.toSet().toList();
      _items1.sort((a, b) {
        return a['value'].compareTo(b['value']);
      });
      print(_phone);
      if(_items1.length>0) {
        Navigator.of(context).push(MaterialPageRoute(
            builder: (context) => AddDataScreen(_items1, _phone),
        ));
      }
    }
  }
  
  getwellidsforedit() async{
    User? user = _auth.currentUser;  // This is Firebase User
    if (user != null) {
      _phone = user.phoneNumber!.substring(3, user.phoneNumber!.length);
      getwellidList();
      _items1.clear();
      for (int i = 0; i < list1.length; i++) {
        if (list1[i].phone == _phone) {
          var s = list1[i].wellid.split(',');
          for (int j = 0; j < s.length; j++) {
            var temp=s[j].indexOf(' ');
            if(temp!=-1){
              s[j]=s[j].trim();
            }
            _items1.add({
              'value': s[j],
              'label': s[j],
            });
          }
        }
      }
      _items1.toSet().toList();
      _items1.sort((a, b) {
        return a['value'].compareTo(b['value']);
      });
      if(_items1.length>0) {
        Navigator.of(context).push(MaterialPageRoute(
            builder: (context) => ViewAddedDataScreen(_items1)
        ));
      }
    }
  }
  
  getwellidList() async {
    var snapshot = await FirebaseFirestore.instance.collection("user").get();
    list1 = snapshot.docs.map((result) {
      return UserProfile(  // Using UserProfile instead of User
        name: result['name'],
        phone: result['phone'],
        wellid: result['wellid'],
        address: result['address'],
        city: result['city'],
        pin: result['pin'],
        state:result['state'],
        id:result['id'],
      );
    }).toList();
    setState(() {});
  }
  
  @override
  Widget build(BuildContext context) {
    return SafeArea(
        child: FutureBuilder(
        future: getwellidList(),
    builder: (BuildContext context, snapshot) {
    return Scaffold(
      appBar: AppBar(
        title: Text(
          AppLocalizations.of(context)!.home,
        ),
        backgroundColor: Colors.orange!,
        actions: [
          LanguagePicker(),
        
          IconButton(
            icon: Icon(Icons.logout, color: Colors.red[900]),
            onPressed: () async {
              await FirebaseAuth.instance.signOut();
              Navigator.pushAndRemoveUntil(
                  context,
                  MaterialPageRoute(builder: (context) => WelcomeScreen()),
                  (route) => false);
            },
          )
        ],
      ),
      body: Container(
        child: Center(
          child: Padding(
            padding: const EdgeInsets.all(8.0),
            child: SingleChildScrollView(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Padding(
                    padding: const EdgeInsets.all(8.0),
                    child: RoundedButton(
                      text: AppLocalizations.of(context)!.add,
                      color: Colors.orange[700]!,
                      textColor: Colors.white,
                      press:(){
                        getwellidsforadding();
                      },
                    ),
                  ),
                  Padding(
                    padding: const EdgeInsets.all(8.0),
                    child: RoundedButton(
                      text: AppLocalizations.of(context)!.update,
                      color: Colors.orange[700]!,
                      textColor: Colors.white,
                      press:(){
                        getwellidsforedit();
                      },
                    ),
                  ),
                  Padding(
                    padding: const EdgeInsets.all(8.0),
                    child: RoundedButton(
                      text: AppLocalizations.of(context)!.search,
                      color: Colors.orange[700]!,
                      textColor: Colors.white,
                      press:(){
                        Navigator.push(
                            context, MaterialPageRoute(builder: (context) => SearchScreen()));
                      },
                    ),
                  ),
                  Padding(
                    padding: const EdgeInsets.all(8.0),
                    child: RoundedButton(
                      text: AppLocalizations.of(context)!.visualizedata,
                      color: Colors.orange[700]!,
                      textColor: Colors.white,
                      press:(){
                        Navigator.push(
                            context, MaterialPageRoute(builder: (context) => GraphScreen()));
                      },
                    ),
                  ),
                  Padding(
                    padding: const EdgeInsets.all(8.0),
                    child: RoundedButton(
                      text: AppLocalizations.of(context)!.comparegraph,
                      color: Colors.orange[700]!,
                      textColor: Colors.white,
                      press:(){
                        Navigator.push(
                            context, MaterialPageRoute(builder: (context) => CompareGraphScreen()));
                      },
                    ),
                  ),
                  Padding(
                    padding: const EdgeInsets.all(8.0),
                    child: RoundedButton(
                      text: AppLocalizations.of(context)!.profile,
                      color: Colors.orange[700]!,
                      textColor: Colors.white,
                      press:(){
                        getUserDetail();
                      },
                    ),
                  ),
                  // ← NEW BLUETOOTH CONTROL BUTTON ADDED BELOW
                  Padding(
                    padding: const EdgeInsets.all(8.0),
                    child: RoundedButton(
                      text: "Bluetooth Control",
                      color: Colors.blue[700]!,
                      textColor: Colors.white,
                      press: () {
                        Navigator.push(
                          context,
                          MaterialPageRoute(builder: (context) => BluetoothControlScreen()),
                        );
                      },
                    ),
                  ),
                  Padding(
                    padding: const EdgeInsets.all(8.0),
                    child: RoundedButton(
                      text: "AI Predictions (Indore ML)",
                      color: Colors.green[700]!,
                      textColor: Colors.white,
                      press: () {
                        Navigator.push(
                          context,
                          MaterialPageRoute(
                            builder: (context) => const PredictionScreen(
                              wellId: 'INDORE_DEMO_WELL',
                              latitude: 22.7196,
                              longitude: 75.8577,
                              currentDepth: 12.5,
                            ),
                          ),
                        );
                      },
                    ),
                  ),
  
                  
                ],
              ),
            ),
          ),
        ),
      ),
      );
    }),
    );
  }
}
